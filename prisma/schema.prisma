generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(uuid())
  name          String
  gender        String
  role          String
  createdAt     DateTime          @default(now())
  email         String?           @unique
  phone         String?
  photoURL      String?
  updatedAt     DateTime?         @updatedAt
  callsMade     Call[]            @relation("Caller")
  callsReceived Call[]            @relation("Receiver")
  giftsReceived GiftTransaction[] @relation("Receiver")
  giftsSent     GiftTransaction[] @relation("Sender")
  transactions  Transaction[]
  wallet        Wallet?
  withdrawals   Withdrawal[]
  age           Int?     
  bio           String?   
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Transaction {
  id              String   @id @default(uuid())
  userId          String
  type            String   // "deposit", "withdrawal", "call_charge", "gift_sent", "gift_received", "refund"
  amount          Int      // Amount in coins
  balanceBefore   Int      // Balance before transaction
  balanceAfter    Int      // Balance after transaction
  status          String   // "pending", "completed", "failed", "cancelled"
  description     String?  // Transaction description
  metadata        Json?    // Additional metadata (paymentId, giftId, callId, etc.)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
  
  @@index([userId, createdAt])
  @@index([type])
  @@index([status])
}

model Payment {
  id                String   @id @default(uuid())
  userId            String
  stripePaymentId   String?  @unique // Stripe Payment Intent ID
  stripeSessionId   String?  @unique // Stripe Checkout Session ID
  amount            Float    // Amount in USD
  currency          String   @default("usd")
  coins             Int      // Coins to be credited
  status            String   // "pending", "succeeded", "failed", "cancelled", "refunded"
  paymentMethod     String?  // "card", "bank_transfer", etc.
  stripeCustomerId  String?  // Stripe Customer ID
  metadata          Json?    // Additional Stripe metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([stripePaymentId])
  @@index([stripeSessionId])
}

model Call {
  id         String    @id @default(uuid())
  callerId   String
  receiverId String
  status     String
  startTime  DateTime  @default(now())
  endTime    DateTime?
  totalCoins Int       @default(0)
  caller     User      @relation("Caller", fields: [callerId], references: [id])
  receiver   User      @relation("Receiver", fields: [receiverId], references: [id])
}

model Gift {
  id       String            @id @default(uuid())
  name     String
  cost     Int
  imageUrl String?
  sent     GiftTransaction[]
}

model GiftTransaction {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  giftId     String
  coinsSpent Int
  createdAt  DateTime @default(now())
  gift       Gift     @relation(fields: [giftId], references: [id])
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id])
  sender     User     @relation("Sender", fields: [senderId], references: [id])
}

model Withdrawal {
  id        String   @id @default(uuid())
  userId    String
  coins     Int
  status    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AppConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CoinBundle {
  id          String   @id @default(uuid())
  name        String
  coins       Int      // Number of coins in bundle
  price       Float    // Price in USD
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([isActive, sortOrder])
}

model PromoCode {
  id                String            @id @default(uuid())
  code              String            @unique // The promo code itself (e.g., "WELCOME10")
  promoType         String            // "percentage", "fixed_amount", "bonus_coins", "free_bundle"
  discountValue     Float             // Discount value (percentage or fixed amount)
  bonusCoins        Int               @default(0) // Bonus coins to add
  maxUsage          Int               // Maximum total usage count
  currentUsage      Int               @default(0) // Current usage count
  perUserMaxUsage   Int               @default(1) // How many times one user can use it
  expiryTime        DateTime?         // When it expires (null = no expiry)
  applicableBundles Json?             // Array of bundle IDs this applies to (null = all bundles)
  minPurchaseAmount Float             @default(0) // Minimum purchase amount required
  isActive          Boolean           @default(true)
  description       String?           // Description of the promo
  createdBy         String?           // Admin who created it
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  usages            PromoCodeUsage[]
  
  @@index([code])
  @@index([isActive, expiryTime])
}

model PromoCodeUsage {
  id          String    @id @default(uuid())
  promoCodeId String
  userId      String
  orderId     String?   // Transaction or payment ID
  discountAmount Float  // Actual discount amount applied
  bonusCoins  Int       @default(0) // Bonus coins received
  createdAt   DateTime  @default(now())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  
  @@index([promoCodeId])
  @@index([userId])
  @@index([promoCodeId, userId])
}