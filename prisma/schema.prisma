generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(uuid())
  name          String
  gender        String
  role          String
  createdAt     DateTime          @default(now())
  email         String?           @unique
  phone         String?
  photoURL      String?
  updatedAt     DateTime?         @updatedAt
  callsMade     Call[]            @relation("Caller")
  callsReceived Call[]            @relation("Receiver")
  giftsReceived GiftTransaction[] @relation("Receiver")
  giftsSent     GiftTransaction[] @relation("Sender")
  transactions  Transaction[]
  wallet        Wallet?
  withdrawals   Withdrawal[]
  age           Int?     
  bio           String?   
  referralCode    String?           @unique
  referredBy      String?
  referralStats   UserReferralStats?
  referralsMade   Referral[]        @relation("Referrer")
  referredByUser  Referral?         @relation("ReferredUser")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Transaction {
  id              String   @id @default(uuid())
  userId          String
  type            String   // "deposit", "withdrawal", "call_charge", "gift_sent", "gift_received", "refund"
  amount          Int      // Amount in coins
  balanceBefore   Int      // Balance before transaction
  balanceAfter    Int      // Balance after transaction
  status          String   // "pending", "completed", "failed", "cancelled"
  description     String?  // Transaction description
  metadata        Json?    // Additional metadata (paymentId, giftId, callId, etc.)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
  
  @@index([userId, createdAt])
  @@index([type])
  @@index([status])
}

model Payment {
  id                String   @id @default(uuid())
  userId            String
  stripePaymentId   String?  @unique // Stripe Payment Intent ID
  stripeSessionId   String?  @unique // Stripe Checkout Session ID
  amount            Float    // Amount in USD
  currency          String   @default("usd")
  coins             Int      // Coins to be credited
  status            String   // "pending", "succeeded", "failed", "cancelled", "refunded"
  paymentMethod     String?  // "card", "bank_transfer", etc.
  stripeCustomerId  String?  // Stripe Customer ID
  metadata          Json?    // Additional Stripe metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([stripePaymentId])
  @@index([stripeSessionId])
}

model Call {
  id         String    @id @default(uuid())
  callerId   String
  receiverId String
  status     String
  startTime  DateTime  @default(now())
  endTime    DateTime?
  totalCoins Int       @default(0)
  caller     User      @relation("Caller", fields: [callerId], references: [id])
  receiver   User      @relation("Receiver", fields: [receiverId], references: [id])
}

model Gift {
  id       String            @id @default(uuid())
  name     String
  cost     Int
  imageUrl String?
  sent     GiftTransaction[]
}

model GiftTransaction {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  giftId     String
  coinsSpent Int
  createdAt  DateTime @default(now())
  gift       Gift     @relation(fields: [giftId], references: [id])
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id])
  sender     User     @relation("Sender", fields: [senderId], references: [id])
}

model Withdrawal {
  id        String   @id @default(uuid())
  userId    String
  coins     Int
  status    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AppConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CoinBundle {
  id          String   @id @default(uuid())
  name        String
  coins       Int      // Number of coins in bundle
  price       Float    // Price in USD
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([isActive, sortOrder])
}


model Referral {
  id              String          @id @default(uuid())
  referrerId      String
  referredUserId  String          @unique
  referralCode    String          @unique
  status          String          @default("PENDING") // PENDING, COMPLETED, EXPIRED
  bonusEarned     Int             @default(0)
  bonusType       String?         // signup, first_call, first_gift, etc.
  createdAt       DateTime        @default(now())
  completedAt     DateTime?
  referrer        User            @relation("Referrer", fields: [referrerId], references: [id])
  referredUser    User            @relation("ReferredUser", fields: [referredUserId], references: [id])
  rewards         ReferralReward[]
  
  @@index([referrerId])
  @@index([referredUserId])
  @@index([referralCode])
  @@index([status])
}

model ReferralReward {
  id              String    @id @default(uuid())
  referralId      String
  type            String    // signup_bonus, call_bonus, gift_bonus
  amount          Int
  status          String    @default("PENDING") // PENDING, CREDITED, EXPIRED
  metadata        Json?     // Additional data like callId, giftId, etc.
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  referral        Referral  @relation(fields: [referralId], references: [id])
  
  @@index([referralId])
  @@index([type])
  @@index([status])
}

model UserReferralStats {
  id                String   @id @default(uuid())
  userId            String   @unique
  totalReferrals    Int      @default(0)
  activeReferrals   Int      @default(0)
  totalEarnings     Int      @default(0)
  availableBalance  Int      @default(0)
  lastUpdated       DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
  
  @@index([userId])
}