generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(uuid())
  name          String
  gender        String
  role          String
  createdAt     DateTime          @default(now())
  email         String?           @unique
  phone         String?
  photoURL      String?
  updatedAt     DateTime?         @updatedAt
  callsMade     Call[]            @relation("Caller")
  callsReceived Call[]            @relation("Receiver")
  giftsReceived GiftTransaction[] @relation("Receiver")
  giftsSent     GiftTransaction[] @relation("Sender")
  transactions  Transaction[]
  wallet        Wallet?
  withdrawals   Withdrawal[]
  age           Int?     
  bio           String?   
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  type      String
  amount    Int
  status    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Call {
  id         String    @id @default(uuid())
  callerId   String
  receiverId String
  status     String
  startTime  DateTime  @default(now())
  endTime    DateTime?
  totalCoins Int       @default(0)
  caller     User      @relation("Caller", fields: [callerId], references: [id])
  receiver   User      @relation("Receiver", fields: [receiverId], references: [id])
}

model Gift {
  id   String            @id @default(uuid())
  name String
  cost Int
  sent GiftTransaction[]
}

model GiftTransaction {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  giftId     String
  coinsSpent Int
  createdAt  DateTime @default(now())
  gift       Gift     @relation(fields: [giftId], references: [id])
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id])
  sender     User     @relation("Sender", fields: [senderId], references: [id])
}

model Withdrawal {
  id        String   @id @default(uuid())
  userId    String
  coins     Int
  status    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
